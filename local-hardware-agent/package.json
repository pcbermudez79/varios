{
  "name": "local-hardware-agent",
  "version": "1.0.0",
  "description": "Agente local liviano para conectar aplicaciones web con impresoras y hardware del cliente (similar a QZ Tray).",
  "main": "src/index.js",
  "bin": {
    "local-hardware-agent": "src/index.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "gen-certs": "node scripts/generate-certs.js",
    "build:win": "pkg . --targets node18-win-x64 --output dist/local-hardware-agent-win.exe",
    "build:mac": "pkg . --targets node18-macos-x64 --output dist/local-hardware-agent-macos",
    "build:linux": "pkg . --targets node18-linux-x64 --output dist/local-hardware-agent-linux",
    "build:all": "pkg . --targets node18-win-x64,node18-macos-x64,node18-linux-x64 --out-path dist"
  },
  "pkg": {
    "assets": [
      "certs/**/*",
      "node_modules/sharp/**/*",
      "node_modules/@node-escpos/**/*"
    ],
    "targets": [
      "node18-win-x64",
      "node18-macos-x64",
      "node18-linux-x64"
    ],
    "outputPath": "dist"
  },
  "dependencies": {
    "ws": "^8.16.0",
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "systeminformation": "^5.21.20",
    "sharp": "^0.33.2",
    "pdf-to-printer": "^5.6.0",
    "unix-print": "^1.3.0",
    "uuid": "^9.0.1",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "pkg": "^5.8.1",
    "node-forge": "^1.3.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "pcbermudez79",
  "license": "MIT"
}
