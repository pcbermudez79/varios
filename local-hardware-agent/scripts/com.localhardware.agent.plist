<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>              <string>com.localhardware.agent</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/local-hardware-agent-macos</string>
  </array>
  <key>RunAtLoad</key>          <true/>
  <key>KeepAlive</key>          <true/>
  <key>StandardOutPath</key>    <string>/tmp/local-hardware-agent.out.log</string>
  <key>StandardErrorPath</key>  <string>/tmp/local-hardware-agent.err.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>AGENT_ALLOWED_ORIGINS</key>
    <string>https://mi-app.ejemplo.com,http://localhost:3000</string>
  </dict>
</dict>
</plist>
